{
  "name": "bu-wanyouxi-client",
  "version": "1.0.0",
  "description": "不玩游戏 — Steam 启发式桌面客户端（Electron + Vite，原生 JS）",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node electron/run.js",
    "build": "vite build",
    "test": "node --test tests/state.test.js tests/completion.test.js tests/restart.test.js tests/reveal-flow.test.js tests/library-flow.test.js tests/store-flow.test.js tests/migration.test.js",
    "visual:compare": "node tools/visual-run.cjs compare",
    "visual:capture": "node tools/visual-run.cjs capture",
    "start": "cross-env NODE_ENV=production node electron/run.js",
    "preview": "vite build && cross-env NODE_ENV=production node electron/run.js",
    "dist": "vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win"
  },
  "build": {
    "appId": "com.buwanyouxi.client",
    "productName": "不玩游戏",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "不玩游戏"
    },
    "portable": {
      "artifactName": "不玩游戏-Portable-${version}.exe"
    }
  },
  "author": "不玩游戏",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
